{
  "name": "oziel-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Home interactivo del portafolio de Oziel Rodman Ramos Torrez (React + Phaser).",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/sync-assets.mjs --if-missing",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "audit:assets": "python -I tools/audit/audit_assets.py Recursos/assets_home_oziel docs/audit",
    "rig": "node tools/rig/build_characters.cjs && node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "phaser": "3.90.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "sharp": "^0.34.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
